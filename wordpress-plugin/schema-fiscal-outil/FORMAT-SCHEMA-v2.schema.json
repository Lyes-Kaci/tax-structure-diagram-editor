{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fiscaliteinternationale.fr/schema-fiscal/format-v2.schema.json",
  "title": "Document de schéma fiscal v2",
  "type": "object",
  "required": ["v", "ents", "dets", "flux"],
  "properties": {
    "v": {"const": 2},
    "meta": {"type": "object"},
    "ents": {"type": "array", "maxItems": 2500, "items": {"$ref": "#/$defs/entity"}},
    "dets": {"type": "array", "maxItems": 2500, "items": {"$ref": "#/$defs/link"}},
    "flux": {"type": "array", "maxItems": 2500, "items": {"$ref": "#/$defs/link"}},
    "traits": {"type": "array", "maxItems": 100, "items": {"type": "object"}},
    "replie": {"type": "array", "items": {"type": "string", "maxLength": 160}},
    "opt": {"type": "object"}
  },
  "additionalProperties": true,
  "$defs": {
    "entity": {
      "type": "object",
      "required": ["id", "nom"],
      "properties": {
        "id": {"type": "string", "maxLength": 160},
        "nom": {"type": "string", "minLength": 1, "maxLength": 240},
        "forme": {"type": "string", "maxLength": 160},
        "pays": {"type": "string", "maxLength": 16},
        "note": {"type": "string", "maxLength": 6000},
        "x": {"type": ["number", "null"]},
        "y": {"type": ["number", "null"]}
      },
      "additionalProperties": true
    },
    "link": {
      "type": "object",
      "required": ["src", "dst"],
      "properties": {
        "id": {"type": "string", "maxLength": 160},
        "src": {"type": "string", "maxLength": 160},
        "dst": {"type": "string", "maxLength": 160},
        "pct": {"type": ["number", "string", "null"]},
        "note": {"type": "string", "maxLength": 6000}
      },
      "additionalProperties": true
    }
  }
}
